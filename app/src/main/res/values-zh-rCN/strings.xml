<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="acc_desc">在最前面的应用上覆盖一层完全不透明的反色画面，而手写笔与触控会直接穿透到底下的应用。之所以需要无障碍权限，是因为只有受信任的覆盖层才能同时做到不透明与不拦截触控；而且在这类设备上，单个窗口截图是唯一不会把覆盖层本身也拍进去的捕获方式。</string>

    <string name="hint_overlay">覆盖层是不透明的，所以你在本应用里时它会自动隐藏，离开后自动回来。手写笔与触控一律穿透到底下的应用。</string>

    <string name="section_mode">模式</string>
    <string name="mode_passthrough">关闭／原样显示</string>
    <string name="mode_luma">灰度反色（墨水屏最佳）</string>
    <string name="mode_rgb">RGB 反色（照片会变负片）</string>
